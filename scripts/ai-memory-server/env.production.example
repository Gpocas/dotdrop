# Copiar para /opt/ai-memory/.env.production na VM (chmod 600). NUNCA versionar o real.
# Token: docker run --rm akitaonrails/ai-memory:3.1.0 generate-auth-token
AI_MEMORY_AUTH_TOKEN=GERE_COM_generate-auth-token
AI_MEMORY_ALLOWED_HOSTS=34-135-252-238.sslip.io,localhost,127.0.0.1
AI_MEMORY_AUTH__SECURE_COOKIE=true
# Com GEMINI_API_KEY vazia o servidor nao sobe se o provider estiver ativo:
# so descomente o provider depois de preencher a chave.
AI_MEMORY_LLM_PROVIDER=gemini
AI_MEMORY_LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
